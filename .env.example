# Copy to .env.local for your laptop (never commit .env.local), or set these in Vercel → Settings → Environment Variables.
# NO REAL VALUES IN THIS FILE.

# Database (libSQL). Laptop default: file:data/shishya.db. Demo: file:data/demo.db.
# Cloud (Vercel): your Turso database URL, like libsql://shishya-<your-org>.turso.io
DATABASE_URL=file:data/shishya.db
# Turso only: the database auth token (leave empty for a local file)
DATABASE_AUTH_TOKEN=

# Signs the login cookies. Required in production: 32+ random characters
# (for example the output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=

# Hours between a failed proof and the next one (default 24; 0 only for demos)
PROOF_COOLDOWN_HOURS=24

# AI, free tiers only. Used by the Misconception Miner (npm run miner); the AI hint tutor is off and never shown to Class 7.
AI_TUTOR_ENABLED=0
# Providers tried in this order; if one fails or is rate-limited (HTTP 429) the next is tried.
LLM_PROVIDERS=groq,openrouter
# Model names are not in the code: free models come and go. A provider without a model name is skipped.
# Checked on 2026-10-19 (both available and listed with tool calling). If a provider answers HTTP 404, the model
# was retired: list current ones with GET https://api.groq.com/openai/v1/models or https://openrouter.ai/api/v1/models.
# Groq (https://console.groq.com, free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (https://openrouter.ai): only ":free" models are allowed
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Most AI calls per provider per day (stays inside the free limits)
LLM_DAILY_CAP=200
